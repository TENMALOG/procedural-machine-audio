{
  "name": "procedural-machine-audio",
  "version": "0.1.0",
  "description": "A procedural audio engine for interactive machines and simulations (Web Audio, no samples).",
  "private": true,
  "license": "MIT",
  "author": "TENMALOG",
  "homepage": "https://qm4.rewrite.tw/",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-TW.md",
    "README.ja.md",
    "README.vi.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "web-audio",
    "procedural-audio",
    "sound-synthesis",
    "simulation",
    "asmr",
    "typescript"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json",
    "build:demo": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
